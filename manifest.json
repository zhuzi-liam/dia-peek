{
  "manifest_version": 3,
  "name": "Dia Peek",
  "version": "1.3.3",
  "description": "按住 Shift 点击链接，在当前页面上方弹出悬浮预览窗（还原 Arc 的 Peek）。",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "main-world.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Dia Peek",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "peek-hovered-link": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "预览鼠标下方的链接"
    }
  }
}
